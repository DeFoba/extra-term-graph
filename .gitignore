# Neo4j credentials file (contains sensitive plain-text password)
Neo4j-*.txt

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Raw data and generated datasets (highly recommended to exclude from version control)
articles/
corpus/
graph_export/

# Report and template files (not part of the codebase)
report/
template_report.txt

# Virtual environment (in case one is created locally)
.venv/
venv/
env/
ENV/

# Local editor/IDE configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Neo4j server run script and ignored runtime data (keep bin and libs in Git)
neo4j-community-5.26.0/data/
neo4j-community-5.26.0/logs/
neo4j-community-5.26.0/run/

# Document and archive folders
vkr_documents/
archive/
